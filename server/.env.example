PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/courier_ms
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_URL=http://localhost:5173

# Courier/vendor forwarding integration (server/src/integrations/courier).
# Timeout applied to every outbound vendor API call.
COURIER_API_TIMEOUT=30000

# Fill these in only once you have each vendor's official API documentation and credentials —
# see the "PENDING IMPLEMENTATION" comment at the top of each provider file. Until then, any
# Vendor record whose vendorCode isn't BLUEDART/DTDC/FEDEX/DHL (or that resolves to one of
# these without the matching env vars set) is routed to the built-in mock provider instead.
BLUEDART_API_URL=
BLUEDART_CLIENT_ID=
BLUEDART_CLIENT_SECRET=
BLUEDART_API_KEY=

DTDC_API_URL=
DTDC_API_KEY=

FEDEX_API_URL=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=

DHL_API_URL=
DHL_API_KEY=

# GST e-Invoice IRN generation (server/src/integrations/irn) — via NIC's Invoice Registration
# Portal directly, or a GSP (GST Suvidha Provider). Until GST_IRN_API_URL and an API key/secret
# are both set, invoices are routed to the built-in mock IRN provider instead (see
# nic/nic.irn.provider.js's "PENDING IMPLEMENTATION" comment).
GST_IRN_API_URL=
GST_IRN_CLIENT_ID=
GST_IRN_CLIENT_SECRET=
GST_IRN_USERNAME=
GST_IRN_PASSWORD=
GST_IRN_API_KEY=
